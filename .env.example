# Isi di Vercel > Project ichasoraya91 > Settings > Environment Variables
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Teks acak minimal 32 karakter, contoh hasil: openssl rand -hex 32
AUTH_SECRET=
# Email yang boleh masuk, pisahkan koma. Awali @ untuk satu domain penuh.
ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com
# Database Supabase (Project Settings > API). Kunci rahasia hanya untuk server, jangan dibagikan.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx
